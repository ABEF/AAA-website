# Rendered SVG hashes must survive Windows/macOS/Linux checkouts unchanged.
assets/nfts/*.svg text eol=lf
assets/nfts/metadata/*.json text eol=lf
assets/nfts/manifest.json text eol=lf
assets/nfts/inventory.json text eol=lf
assets/nfts/sources/provenance.json text eol=lf
assets/nfts/sources/*.webp binary

# Preserve existing Windows line endings in this view.
deployment-view.js whitespace=cr-at-eol
