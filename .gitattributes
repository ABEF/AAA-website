# Rendered SVG hashes must survive Windows/macOS/Linux checkouts unchanged.
assets/nfts/*.svg text eol=lf
assets/nfts/metadata/*.json text eol=lf
assets/nfts/manifest.json text eol=lf
assets/nfts/inventory.json text eol=lf
assets/nfts/sources/provenance.json text eol=lf
assets/nfts/sources/*.webp binary

# Preserve existing Windows line endings in this view.
deployment-view.js whitespace=cr-at-eol

# Preserve exact reviewed ownership-reader and focused-check bytes.
deployment-api.js -text whitespace=cr-at-eol
tests/ownership-paging.test.mjs -text whitespace=cr-at-eol
package.json -text whitespace=cr-at-eol

# Preserve exact reviewed wallet-financial reader, tests and fixtures.
deployment-view.js -text whitespace=cr-at-eol
tests/wallet-financial-view.test.mjs -text whitespace=cr-at-eol
tests/fixtures/wallet-view-20261121/** -text whitespace=cr-at-eol
